# systemd user unit for the SSH tunnel. Linux only.
# Copy to ~/.config/systemd/user/opencode-egress.service, replace my-vps with
# your SSH config alias, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now opencode-egress.service
[Unit]
Description=SSH tunnel to a loopback tinyproxy for OpenCode
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L 127.0.0.1:8888:127.0.0.1:8888 my-vps
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
